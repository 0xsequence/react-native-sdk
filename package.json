{
  "name": "@polygonlabs/oms-wallet-react-native",
  "version": "0.2.0",
  "description": "OMS Wallet SDK for React Native and Expo development builds.",
  "homepage": "https://github.com/0xPolygon/oms-wallet-react-native-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xPolygon/oms-wallet-react-native-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/0xPolygon/oms-wallet-react-native-sdk/issues"
  },
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "API.md",
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "!examples/**",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace oms-client-react-native-sdk-example",
    "sdk-example": "yarn workspace oms-client-react-native-sdk-example",
    "trails-actions-example": "yarn workspace oms-client-react-native-sdk-trails-actions-example",
    "expo-example": "cd examples/expo-example && npm start",
    "expo-example:android": "cd examples/expo-example && npm run android",
    "expo-example:ios": "cd examples/expo-example && npm run ios",
    "expo-example:install": "bash scripts/install-expo-example-dependencies.sh",
    "expo-example:install:published": "bash scripts/install-expo-example-dependencies.sh --published",
    "expo-example:prebuild": "cd examples/expo-example && npx expo prebuild --no-install --clean",
    "expo-example:verify-autolinking": "node scripts/verify-expo-autolinking.mjs",
    "clean": "del-cli android/build examples/sdk-example/android/build examples/sdk-example/android/app/build examples/sdk-example/ios/build examples/trails-actions-example/android/build examples/trails-actions-example/android/app/build examples/trails-actions-example/ios/build lib",
    "build": "bob build",
    "prepare": "yarn build && husky",
    "prepack": "yarn build && yarn check:api:built && yarn check:native-versions",
    "generate:api": "yarn build && yarn generate:api:built",
    "generate:api:built": "node scripts/generate-api.mjs",
    "check:api": "yarn build && yarn check:api:built",
    "check:api:built": "node scripts/generate-api.mjs --check",
    "check:exports": "publint",
    "check:package": "node scripts/check-package.mjs",
    "check:native-versions": "node scripts/check-native-sdk-versions.mjs",
    "codegen-drift-check": "yarn build && yarn check:api:built && yarn check:exports && yarn check:native-versions && yarn check:package",
    "test": "yarn build && yarn test:built",
    "test:built": "node --test test/*.test.js",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,cjs,mjs,ts,tsx}\"",
    "commitlint": "commitlint",
    "lint-staged": "lint-staged",
    "changeset": "changeset",
    "verify": "yarn lint && yarn typecheck && yarn build && yarn test:built && yarn check:api:built && yarn check:exports && yarn check:native-versions"
  },
  "keywords": [
    "react-native",
    "expo",
    "wallet",
    "ios",
    "android"
  ],
  "author": "0xSequence <dev@sequence.xyz> (https://sequence.xyz)",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/compat": "^2.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "publint": "^0.3.22",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.42.1",
    "turbo": "^2.8.21",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "react": ">=19.2.0",
    "react-native": ">=0.85.0"
  },
  "workspaces": [
    "examples/*",
    "!examples/expo-example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "OmsWalletReactNativeSdkSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.omswalletreactnativesdk"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint"
    ],
    "version": "0.62.0"
  }
}
