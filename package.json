{
  "name": "@0xsequence/react-native-sdk",
  "version": "0.3.2",
  "description": "Sequence v3 React Native SDK",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-sdk-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "release": "release-it --only-version"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xsequence/react-native-sdk.git"
  },
  "author": "0xsequence",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/0xsequence/react-native-sdk/issues"
  },
  "homepage": "https://github.com/0xsequence/react-native-sdk#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@0xsequence/dapp-client": "3.0.0-beta.12",
    "@0xsequence/relayer": "3.0.0-beta.12",
    "@0xsequence/wallet-core": "3.0.0-beta.12",
    "@0xsequence/wallet-primitives": "3.0.0-beta.12",
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.4",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/compat": "^2.0.2",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@evilmartians/lefthook": "^2.0.16",
    "@react-native/babel-preset": "0.83.1",
    "@react-native/eslint-config": "^0.83.1",
    "@release-it/conventional-changelog": "^10.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "commitlint": "^20.4.1",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^2.0.3",
    "eslint-plugin-prettier": "^5.5.5",
    "expo": "~54.0.33",
    "expo-crypto": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-secure-store": "~15.0.8",
    "expo-standard-web-crypto": "~3.0.8",
    "expo-web-browser": "~15.0.10",
    "hermes-eslint": "^0.33.3",
    "jest": "^30.2.0",
    "ox": "^0.12.0",
    "prettier": "^3.8.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-builder-bob": "^0.40.17",
    "react-native-mmkv": "^4.1.2",
    "react-native-nitro-modules": "^0.33.2",
    "react-native-url-polyfill": "^3.0.0",
    "release-it": "^19.2.4",
    "typescript": "^5.9.3",
    "viem": "^2.45.1"
  },
  "peerDependencies": {
    "@0xsequence/dapp-client": "3.0.0-beta.12",
    "@0xsequence/wallet-core": "3.0.0-beta.12",
    "@0xsequence/wallet-primitives": "3.0.0-beta.12",
    "expo": "~54.0.33",
    "expo-crypto": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-secure-store": "~15.0.8",
    "expo-standard-web-crypto": "~3.0.8",
    "expo-web-browser": "~15.0.10",
    "ox": "^0.12.0",
    "react": "*",
    "react-native": "*",
    "react-native-mmkv": "^4.1.2",
    "react-native-nitro-modules": "^0.33.2",
    "react-native-url-polyfill": "^3.0.0",
    "viem": "^2.45.1"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@3.6.1",
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "languages": "js",
    "type": "library",
    "version": "0.54.2"
  },
  "resolutions": {
    "@0xsequence/guard": "3.0.0-beta.12",
    "@0xsequence/relayer": "3.0.0-beta.12",
    "@0xsequence/wallet-core": "3.0.0-beta.12",
    "@0xsequence/dapp-client": "3.0.0-beta.12",
    "@0xsequence/wallet-primitives": "3.0.0-beta.12"
  }
}
