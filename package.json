{
  "name": "@0xsequence/react-native-sdk",
  "version": "0.2.0",
  "description": "Sequence v3 React Native SDK",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-sdk-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "release": "release-it --only-version"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xsequence/react-native-sdk.git"
  },
  "author": "0xsequence",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/0xsequence/react-native-sdk/issues"
  },
  "homepage": "https://github.com/0xsequence/react-native-sdk#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@0xsequence/dapp-client": "3.0.0-beta.12",
    "@0xsequence/relayer": "3.0.0-beta.12",
    "@0xsequence/wallet-core": "3.0.0-beta.12",
    "@0xsequence/wallet-primitives": "3.0.0-beta.12",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@evilmartians/lefthook": "^1.12.3",
    "@react-native/babel-preset": "0.81.1",
    "@react-native/eslint-config": "^0.81.1",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.12",
    "commitlint": "^19.8.1",
    "del-cli": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "expo-crypto": "^14.1.5",
    "expo-linking": "~7.1.5",
    "expo-secure-store": "~13.0.2",
    "expo-standard-web-crypto": "^2.1.4",
    "expo-web-browser": "~14.2.0",
    "jest": "^29.7.0",
    "ox": "^0.9.6",
    "prettier": "^3.6.2",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-builder-bob": "^0.40.13",
    "react-native-mmkv": "^3.3.3",
    "react-native-url-polyfill": "^2.0.0",
    "release-it": "^19.0.4",
    "typescript": "^5.9.2",
    "viem": "^2.29.3"
  },
  "peerDependencies": {
    "@0xsequence/dapp-client": "3.0.0-beta.4",
    "@0xsequence/wallet-core": "3.0.0-beta.4",
    "@0xsequence/wallet-primitives": "3.0.0-beta.4",
    "expo-crypto": "^14.1.5",
    "expo-linking": "~7.1.5",
    "expo-secure-store": "~13.0.2",
    "expo-standard-web-crypto": "^2.1.4",
    "expo-web-browser": "~14.2.0",
    "ox": "^0.9.6",
    "react": "*",
    "react-native": "*",
    "react-native-mmkv": "^3.3.3",
    "react-native-url-polyfill": "^2.0.0",
    "viem": "^2.29.3"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@3.6.1",
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "languages": "js",
    "type": "library",
    "version": "0.54.2"
  },
  "resolutions": {
    "@0xsequence/guard": "3.0.0-beta.12",
    "@0xsequence/relayer": "3.0.0-beta.12",
    "@0xsequence/wallet-core": "3.0.0-beta.12",
    "@0xsequence/dapp-client": "3.0.0-beta.12",
    "@0xsequence/wallet-primitives": "3.0.0-beta.12"
  }
}
