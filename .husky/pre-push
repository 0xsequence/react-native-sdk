#!/bin/sh

branch=$(git rev-parse --abbrev-ref HEAD)
base_branch=$(node -p "require('./.changeset/config.json').baseBranch")

case "$branch" in
  changeset-release/*) exit 0 ;;
esac

[ "$branch" = "$base_branch" ] && exit 0
git rev-parse --verify "origin/$base_branch" >/dev/null 2>&1 || exit 0

unset GIT_DIR GIT_WORK_TREE

if ! yarn changeset status --since="origin/$base_branch" 2>/dev/null; then
  echo ""
  echo "No changeset found. Add one before pushing:"
  echo "  yarn changeset              # consumer-facing change"
  echo "  yarn changeset add --empty  # docs, CI, tooling, or examples"
  echo ""
  exit 1
fi
